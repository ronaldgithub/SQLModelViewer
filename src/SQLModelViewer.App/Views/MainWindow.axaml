<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQLModelViewer.App.ViewModels"
        xmlns:webview="using:Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="SQLModelViewer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SQLModelViewer"
        Width="1280" Height="800">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="280,*">

        <!-- Toolbar -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="12" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Generate" Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsGenerating}"/>
                <Button x:Name="SaveAsButton" Content="Save HTML As…" Click="SaveAsButton_Click" IsEnabled="{Binding Preview.HasDiagram}"/>
                <Button Content="Open in Browser" Command="{Binding OpenInBrowserCommand}" IsEnabled="{Binding Preview.HasDiagram}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <!-- Left sidebar: connection summary + schema tree -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*" Margin="12">
            <StackPanel Spacing="6" x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}">
                <TextBlock Text="CONNECTION" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                <TextBlock Text="{Binding ConnectionSummary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <Button x:Name="ConnectButton" Content="Connect…" Click="ConnectButton_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="0,16,0,0" x:DataType="vm:SchemaTreeViewModel" DataContext="{Binding SchemaTree}">
                <TextBlock Text="TABLES" FontWeight="Bold" FontSize="11" Opacity="0.6"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,6">
                    <TextBox Grid.Column="0" PlaceholderText="Filter…" Text="{Binding FilterText}"/>
                    <Button Grid.Column="1" Content="All" Command="{Binding SelectAllCommand}" Margin="4,0,0,0"/>
                    <Button Grid.Column="2" Content="None" Command="{Binding SelectNoneCommand}" Margin="4,0,0,0"/>
                </Grid>
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding Schemas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SchemaNodeViewModel">
                                <StackPanel Margin="0,4">
                                    <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked}" Content="{Binding SchemaName}" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding VisibleTables}" Margin="20,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TableNodeViewModel">
                                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Preview pane -->
        <Grid Grid.Row="1" Grid.Column="1" x:DataType="vm:PreviewViewModel" DataContext="{Binding Preview}">
            <webview:NativeWebView Source="{Binding Source}" IsVisible="{Binding ShowWebView}"/>

            <StackPanel IsVisible="{Binding !IsWebViewAvailable}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="420">
                <TextBlock Text="Embedded preview isn't available" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" Opacity="0.8"
                           Text="The Microsoft Edge WebView2 Runtime wasn't found on this machine. Generation, Save As, and Open in Browser still work fully — just without the in-app preview."/>
                <TextBlock Text="Get the WebView2 Runtime →" TextDecorations="Underline" Cursor="Hand"
                           PointerPressed="WebView2Link_PointerPressed" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding !HasDiagram}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6">
                <TextBlock Text="Connect, pick tables, and click Generate to see a diagram here." HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
